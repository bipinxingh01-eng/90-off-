<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>LootRadar 90% Off Deal Finder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body { background-color: #0b0f19; color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .glass-card { background: rgba(22, 27, 46, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
    .loot-gradient { background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%); }
  </style>
</head>
<body class="min-h-screen pb-20">

  <!-- Header -->
  <header class="p-4 border-b border-gray-800 glass-card sticky top-0 z-50 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl loot-gradient flex items-center justify-center font-black text-black text-lg">⚡</div>
      <div>
        <h1 class="text-lg font-black tracking-tight leading-none text-white">LootRadar</h1>
        <p class="text-xs text-emerald-400 font-semibold">90% Off Fashion Engine</p>
      </div>
    </div>
    <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold animate-pulse">● LIVE CLEARANCE</span>
  </header>

  <!-- Main Content -->
  <main class="p-4 max-w-xl mx-auto space-y-5">

    <!-- Store Selector & Deep Link Generator -->
    <section class="glass-card p-4 rounded-2xl space-y-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400">1. Deep Link Engine</h2>

      <div class="space-y-3">
        <!-- Store Choice -->
        <div>
          <label class="text-xs text-gray-400 block mb-1">Target Store</label>
          <div class="grid grid-cols-3 gap-2">
            <button onclick="setStore('myntra')" id="btn-myntra" class="store-btn py-2 text-xs font-bold rounded-xl border border-pink-500/40 bg-pink-500/20 text-pink-300">Myntra</button>
            <button onclick="setStore('flipkart')" id="btn-flipkart" class="store-btn py-2 text-xs font-bold rounded-xl border border-gray-700 bg-gray-800 text-gray-400">Flipkart</button>
            <button onclick="setStore('ajio')" id="btn-ajio" class="store-btn py-2 text-xs font-bold rounded-xl border border-gray-700 bg-gray-800 text-gray-400">Ajio</button>
          </div>
        </div>

        <!-- Gender & Category -->
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-xs text-gray-400 block mb-1">Gender</label>
            <select id="gender" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-2.5 text-xs text-white" onchange="buildLinks()">
              <option value="men">Men</option>
              <option value="women">Women</option>
              <option value="unisex">All / Unisex</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-gray-400 block mb-1">Category</label>
            <select id="category" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-2.5 text-xs text-white" onchange="buildLinks()">
              <option value="clothing">All Clothing</option>
              <option value="tshirts">T-Shirts</option>
              <option value="shirts">Shirts</option>
              <option value="jeans">Jeans & Denim</option>
              <option value="shoes">Shoes & Sneakers</option>
              <option value="jackets">Jackets & Hoodies</option>
            </select>
          </div>
        </div>

        <!-- Brand / Query -->
        <div>
          <label class="text-xs text-gray-400 block mb-1">Brand Filter (Optional)</label>
          <input type="text" id="brandInput" placeholder="e.g. Puma, Levi's, Roadster" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-2.5 text-xs
